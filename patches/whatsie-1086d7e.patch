diff --git i/src/core/omarchy_palette.h w/src/core/omarchy_palette.h
new file mode 100644
index 0000000..5d4b501
--- /dev/null
+++ w/src/core/omarchy_palette.h
@@ -0,0 +1,30 @@
+#pragma once
+
+#include <QColor>
+#include <QFile>
+#include <QJsonDocument>
+#include <QJsonObject>
+#include <QRegularExpression>
+#include <QStandardPaths>
+
+namespace whatsie::core {
+
+inline QJsonObject omarchyPalette()
+{
+    using namespace Qt::StringLiterals;
+    QFile file(QStandardPaths::writableLocation(QStandardPaths::GenericConfigLocation)
+               + u"/whatsie/omarchy-palette.json"_s);
+    if (!file.open(QIODevice::ReadOnly) || file.size() > 4096)
+        return {};
+
+    const auto palette = QJsonDocument::fromJson(file.read(4097)).object();
+    static const QRegularExpression hex(u"^#[0-9a-fA-F]{6}$"_s);
+    for (const auto& key : {u"background"_s, u"foreground"_s, u"accent"_s,
+                            u"selection_background"_s, u"selection_foreground"_s}) {
+        if (!hex.match(palette.value(key).toString()).hasMatch())
+            return {};
+    }
+    return palette;
+}
+
+} // namespace whatsie::core
